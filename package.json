{
  "name": "mobile-pos-pro",
  "productName": "3amory phone POS",
  "version": "1.0.0",
  "description": "3amory phone - Professional Mobile POS & Wallets Management System",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "electron .",
