{
  "appId": "com.elghandourphone.pos",
  "productName": "El Ghandour Phone POS",
  "copyright": "Copyright © 2026 El Ghandour Phone",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "logo-removebg-preview.png",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "logo-removebg-preview.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "El Ghandour Phone POS"
  }
}
